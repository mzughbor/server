#!/usr/bin/env bash
#
# Falcon of Codes - core WordPress provisioner (Phase 4)
# Creates a child domain of falcon.codes, a DB, and a clean WordPress install
# with the chosen theme, on CyberPanel/OpenLiteSpeed. Runs as root.
#
# Usage:
#   provision.sh --subdomain SUB --theme THEME_ID --email EMAIL --client_id ID \
#                [--token RESERVATION_TOKEN] [--force]
#
set -uo pipefail

# ---------------------------------------------------------------- constants
MASTER="falcon.codes"
HOME_BASE="/home/${MASTER}"
SITE_USER="falco6812"
WP="/usr/local/bin/wp"
STATE_DIR="/var/lib/falcon-provisioner"
SECRETS_DIR="${STATE_DIR}/secrets"
RESERVATIONS="${STATE_DIR}/reservations.json"
SITES="${STATE_DIR}/sites.json"
BRIDGE="${STATE_DIR}/bridge.json"
META="/opt/falcon-provisioner/templates/meta.json"
LOG="/var/log/falcon-provisioner.log"
DEFAULT_THEME="twentytwentyfour"
ADMIN_EMAIL_FALLBACK="mzughbo@gmail.com"

RESERVED_WORDS="www portal mail api admin demo-test ns1 ns2 ftp cpanel webmail mx smtp imap pop root blesta falcon static cdn assets"

# ---------------------------------------------------------------- helpers
ts() { date '+%Y-%m-%d %H:%M:%S'; }
log() { echo "[$(ts)] [provision] $*" | tee -a "$LOG" >&2; }
die() { log "ERROR: $*"; echo "PROVISION_FAILED: $*"; exit 1; }

usage() {
  cat >&2 <<EOF
Usage: $0 --subdomain SUB --theme THEME_ID --email EMAIL --client_id ID [--token TOK] [--force]
EOF
  exit 2
}

# ---------------------------------------------------------------- args
SUB=""; THEME_ID=""; EMAIL=""; CLIENT_ID=""; TOKEN=""; FORCE=0
while [ $# -gt 0 ]; do
  case "$1" in
    --subdomain) SUB="${2:-}"; shift 2;;
    --theme)     THEME_ID="${2:-}"; shift 2;;
    --email)     EMAIL="${2:-}"; shift 2;;
    --client_id) CLIENT_ID="${2:-}"; shift 2;;
    --token)     TOKEN="${2:-}"; shift 2;;
    --force)     FORCE=1; shift;;
    -h|--help)   usage;;
    *) die "unknown argument: $1";;
  esac
done

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ -n "$SUB" ] || usage
[ -n "$CLIENT_ID" ] || CLIENT_ID="manual"
[ -n "$EMAIL" ] || EMAIL="$ADMIN_EMAIL_FALLBACK"
[ -n "$THEME_ID" ] || THEME_ID="default"

SUB="$(echo "$SUB" | tr '[:upper:]' '[:lower:]')"
FQDN="${SUB}.${MASTER}"
DOCROOT="${HOME_BASE}/${FQDN}"

log "=== provision start: sub=${SUB} theme=${THEME_ID} client=${CLIENT_ID} email=${EMAIL} force=${FORCE} ==="

# ---------------------------------------------------------------- 1. validate
# POSIX-safe slug validation (3-32 chars, alnum ends, alnum/hyphen middle)
LEN=${#SUB}
if [ "$LEN" -lt 3 ] || [ "$LEN" -gt 32 ] || ! echo "$SUB" | grep -Eq '^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$'; then
  die "invalid subdomain slug: ${SUB}"
fi
for w in $RESERVED_WORDS; do
  [ "$SUB" = "$w" ] && die "subdomain is a reserved word: ${SUB}"
done

# Token validation (if provided): must exist and be unexpired in reservations.json
if [ -n "$TOKEN" ]; then
  if [ -f "$RESERVATIONS" ]; then
    VALID=$(php -r '
      $f=$argv[1]; $sub=$argv[2]; $tok=$argv[3];
      $a=json_decode(@file_get_contents($f),true) ?: [];
      $now=time();
      foreach($a as $r){
        if(($r["token"]??"")===$tok && ($r["subdomain"]??"")===$sub && strtotime($r["expires_at"]??"1970")>$now){ echo "1"; exit; }
      }
      echo "0";
    ' "$RESERVATIONS" "$SUB" "$TOKEN")
    if [ "$VALID" != "1" ]; then
      log "WARN: token did not match an unexpired reservation for ${SUB} (continuing; reservation may have expired)"
    else
      log "token validated against reservation for ${SUB}"
    fi
  fi
fi

# Confirm subdomain still free (site dir / sites.json), unless --force.
ALREADY_IN_SITES=0
if [ -f "$SITES" ]; then
  ALREADY_IN_SITES=$(php -r '
    $f=$argv[1]; $sub=$argv[2];
    $a=json_decode(@file_get_contents($f),true) ?: [];
    foreach($a as $r){ if(($r["subdomain"]??"")===$sub){ echo "1"; exit; } }
    echo "0";
  ' "$SITES" "$SUB")
fi

if [ -d "$DOCROOT" ] || [ "$ALREADY_IN_SITES" = "1" ]; then
  if [ "$FORCE" != "1" ]; then
    die "subdomain already provisioned (docroot exists or in sites.json): ${SUB} (use --force to override)"
  fi
  log "WARN: --force set; continuing despite existing docroot/site record"
fi

# ---------------------------------------------------------------- 2. child domain + SSL
SITE_EXISTED=0
if [ -d "$DOCROOT" ]; then
  SITE_EXISTED=1
  log "docroot already exists, skipping createChild: ${DOCROOT}"
else
  log "creating child domain ${FQDN} via cyberpanel createChild"
  CC_OUT=$(cyberpanel createChild --masterDomain "$MASTER" --childDomain "$FQDN" \
      --owner admin --php 8.3 --ssl 1 --dkim 0 --openBasedir 0 --path "$FQDN" 2>&1)
  log "createChild output: ${CC_OUT}"
  echo "$CC_OUT" | grep -q '"success": 1' || die "createChild failed for ${FQDN}: ${CC_OUT}"
  # Wait for docroot to materialize.
  for i in $(seq 1 10); do
    [ -d "$DOCROOT" ] && break
    sleep 1
  done
  [ -d "$DOCROOT" ] || die "docroot not created: ${DOCROOT}"
fi

# ---------------------------------------------------------------- 3. database
# Identifiers: replace '-' with '_'; DB name <=64, user <=32 chars.
DBBASE="wp_$(echo "$SUB" | tr '-' '_')"
DBNAME="$(echo "$DBBASE" | cut -c1-64)"
DBUSER="$(echo "$DBBASE" | cut -c1-32)"
DBPASS="$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-24)"

if mysql -N -e "SELECT SCHEMA_NAME FROM INFORMATION_SCHEMA.SCHEMATA WHERE SCHEMA_NAME='${DBNAME}';" | grep -q "$DBNAME"; then
  log "database ${DBNAME} already exists; reusing (password reset)"
fi
log "creating database ${DBNAME} and user ${DBUSER}"
mysql -e "CREATE DATABASE IF NOT EXISTS \`${DBNAME}\` CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;" \
  || die "failed to create database ${DBNAME}"
mysql -e "CREATE USER IF NOT EXISTS '${DBUSER}'@'localhost' IDENTIFIED BY '${DBPASS}';" \
  || die "failed to create db user ${DBUSER}"
mysql -e "ALTER USER '${DBUSER}'@'localhost' IDENTIFIED BY '${DBPASS}';" 2>/dev/null
mysql -e "GRANT ALL PRIVILEGES ON \`${DBNAME}\`.* TO '${DBUSER}'@'localhost'; FLUSH PRIVILEGES;" \
  || die "failed to grant privileges on ${DBNAME}"

# ---------------------------------------------------------------- 4. WordPress
# Resolve theme_id -> wp slug via meta.json (php parse).
THEME_SLUG=$(php -r '
  $f=$argv[1]; $id=$argv[2];
  $m=json_decode(@file_get_contents($f),true) ?: [];
  $def=$m["default"] ?? "twentytwentyfour";
  $t=$m["themes"] ?? [];
  echo (isset($t[$id]) && $t[$id]!=="") ? $t[$id] : $def;
' "$META" "$THEME_ID" 2>/dev/null)
[ -n "$THEME_SLUG" ] || THEME_SLUG="$DEFAULT_THEME"
log "theme_id '${THEME_ID}' -> wp slug '${THEME_SLUG}'"

# Remove CyberPanel default placeholder so WP index.php is served.
rm -f "${DOCROOT}/index.html" 2>/dev/null

WP_ADMIN_USER="falconadmin"
WP_ADMIN_PASS="$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-18)"
SITE_TITLE="$(echo "$SUB" | sed 's/-/ /g') on Falcon"

if [ -f "${DOCROOT}/wp-config.php" ] && sudo -u "$SITE_USER" -H "$WP" core is-installed --path="$DOCROOT" >/dev/null 2>&1; then
  log "WordPress already installed at ${DOCROOT}; skipping core install"
else
  log "downloading WordPress core"
  sudo -u "$SITE_USER" -H "$WP" core download --path="$DOCROOT" >>"$LOG" 2>&1 \
    || die "wp core download failed"
  log "creating wp-config"
  sudo -u "$SITE_USER" -H "$WP" config create --path="$DOCROOT" \
    --dbname="$DBNAME" --dbuser="$DBUSER" --dbpass="$DBPASS" --dbhost="localhost" --force >>"$LOG" 2>&1 \
    || die "wp config create failed"
  log "installing WordPress (url=https://${FQDN})"
  sudo -u "$SITE_USER" -H "$WP" core install --path="$DOCROOT" \
    --url="https://${FQDN}" --title="$SITE_TITLE" \
    --admin_user="$WP_ADMIN_USER" --admin_password="$WP_ADMIN_PASS" \
    --admin_email="$EMAIL" --skip-email >>"$LOG" 2>&1 \
    || die "wp core install failed"
fi

# ---------------------------------------------------------------- 5. theme
log "installing theme ${THEME_SLUG}"
if ! sudo -u "$SITE_USER" -H "$WP" theme install "$THEME_SLUG" --activate --path="$DOCROOT" >>"$LOG" 2>&1; then
  log "WARN: theme ${THEME_SLUG} install failed; falling back to ${DEFAULT_THEME}"
  THEME_SLUG="$DEFAULT_THEME"
  sudo -u "$SITE_USER" -H "$WP" theme install "$THEME_SLUG" --activate --path="$DOCROOT" >>"$LOG" 2>&1 \
    || die "fallback theme install failed"
fi
ACTIVE_THEME=$(sudo -u "$SITE_USER" -H "$WP" theme list --status=active --field=name --path="$DOCROOT" 2>/dev/null | head -1)
log "active theme: ${ACTIVE_THEME}"

# ---------------------------------------------------------------- 6. SSL ensure
SSL_STATUS="unknown"
if [ -d "/etc/letsencrypt/live/${FQDN}" ]; then
  SSL_STATUS="issued"
else
  log "SSL cert not found; retrying via cyberpanel issueSSL"
  cyberpanel issueSSL --domainName "$FQDN" >>"$LOG" 2>&1
  if [ -d "/etc/letsencrypt/live/${FQDN}" ]; then SSL_STATUS="issued"; else SSL_STATUS="missing"; fi
fi
HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" "https://${FQDN}/" --max-time 20 2>/dev/null || echo "000")
log "SSL status=${SSL_STATUS}, https HTTP code=${HTTP_CODE}"

# ---------------------------------------------------------------- 6b. per-site FTP/FTPS account (least privilege)
# ACCOUNT TYPE: a pure-ftpd VIRTUAL FTP/FTPS user chrooted to this site's docroot,
# mapped to the site's unprivileged system uid/gid (falco6812) -- NOT root and NOT
# the CyberPanel admin panel login. Rationale: CyberPanel gives no per-customer
# :8090 panel login for a single child domain, and its createFTPAccount CLI is
# broken for child domains ("ChildDomains has no attribute 'package'"). So we write
# the virtual user straight into the SAME MySQL backend CyberPanel/pure-ftpd use
# (cyberpanel.users, MYSQLCrypt=crypt). This is a real, site-scoped, safe account.
CYDB="cyberpanel"
sql_esc(){ printf "%s" "$1" | sed "s/'/''/g"; }
FTP_USER="$SUB"
FTP_PASS="$(openssl rand -base64 18 | tr -d '/+=' | cut -c1-18)"
FTP_HOST="$FQDN"
FTP_PORT=21
FTP_UID="$(id -u "$SITE_USER")"
FTP_GID="$(id -g "$SITE_USER")"
FTP_HASH="$(openssl passwd -6 "$FTP_PASS")"
FTP_STATUS="failed"
if mysql "$CYDB" -N -e "SELECT 1 FROM users WHERE User='$(sql_esc "$FTP_USER")' LIMIT 1;" 2>/dev/null | grep -q 1; then
  mysql "$CYDB" -e "UPDATE users SET Password='$(sql_esc "$FTP_HASH")', Uid=${FTP_UID}, Gid=${FTP_GID}, Dir='$(sql_esc "$DOCROOT")', Status='1', LastModif=NOW() WHERE User='$(sql_esc "$FTP_USER")';" 2>>"$LOG" \
    && FTP_STATUS="updated" || log "WARN: ftp user update failed for ${FTP_USER}"
else
  mysql "$CYDB" -e "INSERT INTO users (User,Password,Uid,Gid,Dir,QuotaSize,Status,ULBandwidth,DLBandwidth,Date,LastModif,domain_id) VALUES ('$(sql_esc "$FTP_USER")','$(sql_esc "$FTP_HASH")',${FTP_UID},${FTP_GID},'$(sql_esc "$DOCROOT")',0,'1',0,0,CURDATE(),NOW(),0);" 2>>"$LOG" \
    && FTP_STATUS="created" || log "WARN: ftp user insert failed for ${FTP_USER}"
fi
FTP_ACCESS="ftps://${FTP_HOST}:${FTP_PORT} (FTP over explicit TLS)"
log "ftp/ftps account ${FTP_USER} (${FTP_STATUS}) dir=${DOCROOT} uid=${FTP_UID}"

# ---------------------------------------------------------------- 7. persist state
mkdir -p "$SECRETS_DIR"; chmod 700 "$SECRETS_DIR"
SECRET_FILE="${SECRETS_DIR}/${SUB}.env"
cat > "$SECRET_FILE" <<EOF
FQDN=${FQDN}
WP_ADMIN_USER=${WP_ADMIN_USER}
WP_ADMIN_PASS=${WP_ADMIN_PASS}
WP_ADMIN_URL=https://${FQDN}/wp-admin/
DB_NAME=${DBNAME}
DB_USER=${DBUSER}
DB_PASS=${DBPASS}
FTP_USER=${FTP_USER}
FTP_PASS=${FTP_PASS}
FTP_HOST=${FTP_HOST}
FTP_PORT=${FTP_PORT}
FTP_ACCESS=${FTP_ACCESS}
FTP_DOCROOT=${DOCROOT}
FTP_STATUS=${FTP_STATUS}
CREATED_AT=$(ts)
EOF
chmod 600 "$SECRET_FILE"
log "secrets written to ${SECRET_FILE} (root 600)"

# Append record to sites.json (atomic via php + flock).
NOW_ISO=$(date -u '+%Y-%m-%dT%H:%M:%S+00:00')
php -r '
  $f=$argv[1];
  $rec=[
    "subdomain"=>$argv[2], "fqdn"=>$argv[3], "db"=>$argv[4], "db_user"=>$argv[5],
    "wp_admin_user"=>$argv[6], "theme_id"=>$argv[7], "wp_theme"=>$argv[8],
    "client_id"=>$argv[9], "email"=>$argv[10], "created_at"=>$argv[11],
    "ssl"=>$argv[12], "ftp_user"=>$argv[13], "ftp_host"=>$argv[14],
    "ftp_status"=>$argv[15], "status"=>"active"
  ];
  $fh=fopen($f,"c+"); flock($fh,LOCK_EX);
  $raw=stream_get_contents($fh); $a=json_decode($raw,true); if(!is_array($a)) $a=[];
  // replace existing record for same subdomain
  $a=array_values(array_filter($a, fn($r)=>($r["subdomain"]??"")!==$argv[2]));
  $a[]=$rec;
  ftruncate($fh,0); rewind($fh); fwrite($fh, json_encode($a, JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT));
  fflush($fh); flock($fh,LOCK_UN); fclose($fh);
' "$SITES" "$SUB" "$FQDN" "$DBNAME" "$DBUSER" "$WP_ADMIN_USER" "$THEME_ID" "$ACTIVE_THEME" "$CLIENT_ID" "$EMAIL" "$NOW_ISO" "$SSL_STATUS" "$FTP_USER" "$FTP_HOST" "$FTP_STATUS" \
  || die "failed to write sites.json"
chmod 640 "$SITES" 2>/dev/null; chgrp "$SITE_USER" "$SITES" 2>/dev/null
log "recorded site in ${SITES}"

# Remove the matching reservation (if any).
if [ -f "$RESERVATIONS" ]; then
  php -r '
    $f=$argv[1]; $sub=$argv[2];
    $fh=fopen($f,"c+"); flock($fh,LOCK_EX);
    $a=json_decode(stream_get_contents($fh),true); if(!is_array($a)) $a=[];
    $a=array_values(array_filter($a, fn($r)=>($r["subdomain"]??"")!==$sub));
    ftruncate($fh,0); rewind($fh); fwrite($fh, json_encode($a, JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT));
    fflush($fh); flock($fh,LOCK_UN); fclose($fh);
  ' "$RESERVATIONS" "$SUB" 2>/dev/null && log "removed reservation for ${SUB}"
fi

# Mark the matching bridge entry claimed (by token if we have one, else subdomain).
if [ -f "$BRIDGE" ]; then
  php -r '
    $f=$argv[1]; $sub=$argv[2]; $tok=$argv[3];
    $fh=fopen($f,"c+"); flock($fh,LOCK_EX);
    $a=json_decode(stream_get_contents($fh),true); if(!is_array($a)) $a=[];
    foreach($a as &$e){
      if(($tok!=="" && ($e["token"]??"")===$tok) || ($e["subdomain"]??"")===$sub){
        $e["claimed"]=true; $e["claimed_at_ts"]=time();
      }
    }
    unset($e);
    ftruncate($fh,0); rewind($fh); fwrite($fh, json_encode($a, JSON_UNESCAPED_SLASHES|JSON_PRETTY_PRINT));
    fflush($fh); flock($fh,LOCK_UN); fclose($fh);
  ' "$BRIDGE" "$SUB" "$TOKEN" 2>/dev/null && log "marked bridge entry claimed for ${SUB}"
fi

# ---------------------------------------------------------------- 8. output
log "=== provision success: https://${FQDN}/ (theme=${ACTIVE_THEME}, http=${HTTP_CODE}) ==="
cat <<EOF
PROVISION_OK
site_url=https://${FQDN}/
wp_admin_url=https://${FQDN}/wp-admin/
wp_admin_user=${WP_ADMIN_USER}
theme_id=${THEME_ID}
wp_theme=${ACTIVE_THEME}
db_name=${DBNAME}
ssl=${SSL_STATUS}
http_code=${HTTP_CODE}
ftp_account_type=pure-ftpd virtual FTP/FTPS user (site-scoped, chroot to docroot)
ftp_user=${FTP_USER}
ftp_host=${FTP_HOST}
ftp_port=${FTP_PORT}
ftp_access=${FTP_ACCESS}
ftp_status=${FTP_STATUS}
secrets=${SECRET_FILE}
EOF
exit 0
