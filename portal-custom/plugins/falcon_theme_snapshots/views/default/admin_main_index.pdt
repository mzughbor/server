        <?php echo (isset($message) ? $message : null); ?>

        <ul class="nav nav-tabs">
            <li class="active"><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/'); ?>"><?php $this->_('AdminMain.index.tab_wp'); ?></a></li>
            <li><a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/blesta/'); ?>"><?php $this->_('AdminMain.index.tab_blesta'); ?></a></li>
        </ul>

        <div class="pad">
            <div class="row">
                <div class="col-md-8">
                    <p class="text-muted" style="margin-bottom: 0;">
                        <?php $this->_('AdminMain.index.catalog_hint'); ?>
                        <a href="<?php echo $this->Html->safe($catalog_url ?? 'https://falcon.codes/api/themes/catalog.php'); ?>" target="_blank" rel="noopener"><?php echo $this->Html->safe($catalog_url ?? ''); ?></a>
                    </p>
                </div>
                <div class="col-md-4 text-right">
                    <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/add/'); ?>" class="btn btn-primary"><i class="fas fa-plus"></i> <?php $this->_('AdminMain.index.link_add'); ?></a>
                </div>
            </div>
        </div>

        <?php
        $this->Widget->clear();
        $this->Widget->create($this->_('AdminMain.index.boxtitle_wp', true), ['id' => 'falcon_wp_templates']);
        ?>
        <div class="inner">
        <?php if (!empty($templates)) { ?>
            <table class="table table-striped table-hover">
                <thead>
                <tr class="heading_row">
                    <th style="width: 50px;"><span><?php $this->_('AdminMain.index.heading_sort'); ?></span></th>
                    <th style="width: 70px;"><span><?php $this->_('AdminMain.index.heading_thumb'); ?></span></th>
                    <th><span><?php $this->_('AdminMain.index.heading_name'); ?></span></th>
                    <th><span><?php $this->_('AdminMain.index.heading_slug'); ?></span></th>
                    <th><span><?php $this->_('AdminMain.index.heading_staging'); ?></span></th>
                    <th style="width: 90px;"><span><?php $this->_('AdminMain.index.heading_active'); ?></span></th>
                    <th style="width: 130px;"><span><?php $this->_('AdminMain.index.heading_captured'); ?></span></th>
                    <th style="width: 220px;"><span><?php $this->_('AdminMain.index.heading_options'); ?></span></th>
                </tr>
                </thead>
                <tbody>
                <?php foreach ($templates as $i => $template) { ?>
                <tr class="<?php echo ($i % 2 == 1) ? 'odd_row' : ''; ?>">
                    <td class="text-center text-muted"><?php echo (int) ($template->sort_order ?? 0); ?></td>
                    <td>
                        <?php if (!empty($template->thumbnail_url)) { ?>
                        <img src="<?php echo $this->Html->safe($template->thumbnail_url); ?>" alt="" class="img-thumbnail" style="max-width: 48px; max-height: 48px;">
                        <?php } else { ?>
                        <span class="text-muted">—</span>
                        <?php } ?>
                    </td>
                    <td>
                        <strong><?php echo $this->Html->safe($template->name ?? ''); ?></strong>
                        <?php if (!empty($template->description)) { ?>
                        <br><small class="text-muted"><?php
                            $desc = (string) ($template->description ?? '');
                            echo $this->Html->safe(strlen($desc) > 60 ? substr($desc, 0, 57) . '...' : $desc);
                        ?></small>
                        <?php } ?>
                    </td>
                    <td><code><?php echo $this->Html->safe($template->slug ?? ''); ?></code></td>
                    <td><a href="https://<?php echo $this->Html->safe($template->staging_domain ?? ''); ?>" target="_blank" rel="noopener"><?php echo $this->Html->safe($template->staging_domain ?? ''); ?></a></td>
                    <td>
                        <?php if (!empty($template->active)) { ?>
                        <span class="label label-success"><?php $this->_('AdminMain.index.yes'); ?></span>
                        <?php } else { ?>
                        <span class="label label-default"><?php $this->_('AdminMain.index.no'); ?></span>
                        <?php } ?>
                    </td>
                    <td><?php echo !empty($template->last_captured) ? $this->Date->cast($template->last_captured) : '<span class="text-muted">—</span>'; ?></td>
                    <td>
                        <div class="btn-group btn-group-xs">
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/edit/' . (int) $template->id . '/'); ?>" class="btn btn-default" title="<?php $this->_('AdminMain.index.action_edit'); ?>"><i class="fas fa-edit"></i></a>
                            <a href="#" class="capture-template btn btn-default" data-id="<?php echo (int) ($template->id ?? 0); ?>" title="<?php $this->_('AdminMain.index.action_capture'); ?>"><i class="fas fa-camera"></i></a>
                            <?php if (!empty($template->active)) { ?>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/activate/' . (int) $template->id . '/0/'); ?>" class="btn btn-warning" title="<?php $this->_('AdminMain.index.action_deactivate'); ?>"><i class="fas fa-eye-slash"></i></a>
                            <?php } else { ?>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/activate/' . (int) $template->id . '/1/'); ?>" class="btn btn-success" title="<?php $this->_('AdminMain.index.action_activate'); ?>"><i class="fas fa-eye"></i></a>
                            <?php } ?>
                            <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/delete/' . (int) $template->id . '/'); ?>" class="btn btn-danger delete-template" data-name="<?php echo $this->Html->safe($template->name ?? $template->slug ?? ''); ?>" title="<?php $this->_('AdminMain.index.action_delete'); ?>"><i class="fas fa-trash"></i></a>
                        </div>
                    </td>
                </tr>
                <?php } ?>
                </tbody>
            </table>
        <?php } else { ?>
            <div class="alert alert-info" style="margin: 0;">
                <i class="fas fa-info-circle"></i> <?php $this->_('AdminMain.index.no_templates'); ?>
            </div>
        <?php } ?>
        </div>
        <?php $this->Widget->end(); ?>

        <script type="text/javascript">
        $(document).ready(function() {
            $('.capture-template').on('click', function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $btn = $(this);
                $btn.prop('disabled', true);
                $.post('<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/capture/'); ?>', { template_id: id })
                    .done(function(data) {
                        if (data.success) {
                            alert(data.message || 'Capture complete.');
                            location.reload();
                        } else {
                            alert(data.message || 'Capture failed.');
                        }
                    })
                    .fail(function() { alert('Capture request failed.'); })
                    .always(function() { $btn.prop('disabled', false); });
            });

            $('.delete-template').on('click', function(e) {
                var name = $(this).data('name') || 'this template';
                if (!confirm('<?php echo $this->_('AdminMain.index.confirm_delete', true); ?>'.replace('%1$s', name))) {
                    e.preventDefault();
                }
            });
        });
        </script>
