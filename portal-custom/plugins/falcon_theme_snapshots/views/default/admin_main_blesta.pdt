        <?php echo (isset($message) ? $message : null); ?>

        <?php $active_tab = 'blesta'; include dirname(__FILE__) . DIRECTORY_SEPARATOR . '_admin_tabs.pdt'; ?>

        <?php
        $this->Widget->clear();
        $this->Widget->create($this->_('AdminMain.blesta.boxtitle', true), ['id' => 'falcon_theme_snapshots']);
        ?>
        <div class="inner">
            <p class="text-muted"><?php $this->_('AdminMain.blesta.phase_notice'); ?></p>
        <?php if (!empty($snapshots)) { ?>
            <table class="table">
                <tr class="heading_row">
                    <td><span><?php $this->_('AdminMain.blesta.heading_label'); ?></span></td>
                    <td><span><?php $this->_('AdminMain.blesta.heading_template'); ?></span></td>
                    <td><span><?php $this->_('AdminMain.blesta.heading_files'); ?></span></td>
                    <td class="last"><span><?php $this->_('AdminMain.blesta.heading_date'); ?></span></td>
                </tr>
                <?php foreach ($snapshots as $i => $snapshot) { ?>
                <tr class="<?php echo ($i % 2 == 1) ? 'odd_row' : ''; ?>">
                    <td><?php echo $this->Html->safe($snapshot->label ?? ''); ?></td>
                    <td><?php echo $this->Html->safe($snapshot->template_dir ?? ''); ?></td>
                    <td><?php echo (int) ($snapshot->file_count ?? 0); ?></td>
                    <td><?php echo !empty($snapshot->date_created) ? $this->Date->cast($snapshot->date_created) : '—'; ?></td>
                </tr>
                <?php } ?>
            </table>
        <?php } else { ?>
            <div class="empty_section">
                <div class="empty_box">
                    <?php $this->_('AdminMain.blesta.no_snapshots'); ?>
                </div>
            </div>
        <?php } ?>
        </div>
        <?php $this->Widget->end(); ?>
