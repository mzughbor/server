        <?php echo (isset($message) ? $message : null); ?>

        <?php $active_tab = 'wp'; include dirname(__FILE__) . DIRECTORY_SEPARATOR . '_admin_tabs.pdt'; ?>

        <div class="pad">
            <p class="text-muted">
                <?php $this->_('AdminMain.index.catalog_hint'); ?>
                <a href="<?php echo $this->Html->safe($catalog_url ?? 'https://falcon.codes/api/themes/catalog.php'); ?>" target="_blank" rel="noopener"><?php echo $this->Html->safe($catalog_url ?? 'https://falcon.codes/api/themes/catalog.php'); ?></a>
            </p>
        </div>

        <?php
        $link_buttons = [
            [
                'icon' => 'fas fa-plus',
                'name' => '',
                'attributes' => [
                    'href' => $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/add/'),
                    'title' => $this->_('AdminMain.index.link_add', true),
                ],
            ],
        ];

        $this->Widget->clear();
        $this->Widget->setLinkButtons($link_buttons);
        $this->Widget->create($this->_('AdminMain.index.boxtitle_wp', true), ['id' => 'falcon_wp_templates']);
        ?>
        <div class="inner">
        <?php if (!empty($templates)) { ?>
            <table class="table">
                <tr class="heading_row">
                    <td><span><?php $this->_('AdminMain.index.heading_name'); ?></span></td>
                    <td><span><?php $this->_('AdminMain.index.heading_slug'); ?></span></td>
                    <td><span><?php $this->_('AdminMain.index.heading_staging'); ?></span></td>
                    <td><span><?php $this->_('AdminMain.index.heading_staging_status'); ?></span></td>
                    <td><span><?php $this->_('AdminMain.index.heading_active'); ?></span></td>
                    <td><span><?php $this->_('AdminMain.index.heading_captured'); ?></span></td>
                    <td class="last"><span><?php $this->_('AdminMain.index.heading_options'); ?></span></td>
                </tr>
                <?php foreach ($templates as $i => $template) { ?>
                <tr class="<?php echo ($i % 2 == 1) ? 'odd_row' : ''; ?>">
                    <td>
                        <?php if (!empty($template->thumbnail_url)) { ?>
                        <img src="<?php echo $this->Html->safe($template->thumbnail_url); ?>" alt="" style="max-width: 32px; max-height: 32px; margin-right: 6px; vertical-align: middle;">
                        <?php } ?>
                        <strong><?php echo $this->Html->safe($template->name ?? ''); ?></strong>
                    </td>
                    <td><code><?php echo $this->Html->safe($template->slug ?? ''); ?></code></td>
                    <td>
                        <?php if (!empty($template->staging_domain)) { ?>
                        <a href="https://<?php echo $this->Html->safe($template->staging_domain); ?>" target="_blank" rel="noopener"><?php echo $this->Html->safe($template->staging_domain); ?></a>
                        <?php } else { ?>—<?php } ?>
                    </td>
                    <td>
                        <?php if (!empty($template->staging_ready)) { ?>
                        <span class="open"><?php $this->_('AdminMain.index.staging_ready'); ?></span>
                        <?php if (!empty($template->staging_admin_url)) { ?>
                        — <a href="<?php echo $this->Html->safe($template->staging_admin_url); ?>" target="_blank" rel="noopener"><?php $this->_('AdminMain.index.staging_wp_admin'); ?></a>
                        <?php } ?>
                        <?php } else { ?>
                        <span class="closed"><?php $this->_('AdminMain.index.staging_missing'); ?></span>
                        <?php } ?>
                    </td>
                    <td>
                        <?php if (!empty($template->active)) { ?>
                        <span class="open"><?php $this->_('AdminMain.index.yes'); ?></span>
                        <?php } else { ?>
                        <span class="closed"><?php $this->_('AdminMain.index.no'); ?></span>
                        <?php } ?>
                    </td>
                    <td><?php echo !empty($template->last_captured) ? $this->Date->cast($template->last_captured) : '—'; ?></td>
                    <td>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/edit/' . (int) $template->id . '/'); ?>"><?php $this->_('AdminMain.index.action_edit'); ?></a>,
                        <a href="#" class="capture-template" data-id="<?php echo (int) ($template->id ?? 0); ?>"><?php $this->_('AdminMain.index.action_capture'); ?></a>,
                        <a href="#" class="provision-staging" data-id="<?php echo (int) ($template->id ?? 0); ?>"><?php $this->_('AdminMain.index.action_provision'); ?></a>,
                        <?php if (!empty($template->active)) { ?>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/activate/' . (int) $template->id . '/0/'); ?>"><?php $this->_('AdminMain.index.action_deactivate'); ?></a>,
                        <?php } else { ?>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/activate/' . (int) $template->id . '/1/'); ?>"><?php $this->_('AdminMain.index.action_activate'); ?></a>,
                        <?php } ?>
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/delete/' . (int) $template->id . '/'); ?>" class="delete-template" data-name="<?php echo $this->Html->safe($template->name ?? $template->slug ?? ''); ?>"><?php $this->_('AdminMain.index.action_delete'); ?></a>,
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/guide/?theme=' . urlencode($template->slug ?? '')); ?>"><?php $this->_('AdminMain.index.action_test'); ?></a>
                    </td>
                </tr>
                <?php } ?>
            </table>
        <?php } else { ?>
            <div class="empty_section">
                <div class="empty_box">
                    <?php $this->_('AdminMain.index.no_templates'); ?>
                    <p style="margin-top: 12px;">
                        <a href="<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/add/'); ?>" class="btn btn-default"><i class="fas fa-plus"></i> <?php $this->_('AdminMain.index.link_add'); ?></a>
                    </p>
                </div>
            </div>
        <?php } ?>
        </div>
        <?php $this->Widget->end(); ?>

        <script type="text/javascript">
        $(document).ready(function() {
            $('.capture-template').on('click', function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $link = $(this);
                var originalText = $link.text();
                $link.addClass('disabled').text('<?php echo $this->_('AdminMain.index.capture_running', true); ?>');

                $(this).blestaRequest(
                    'POST',
                    '<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/capture/'); ?>',
                    { template_id: id },
                    function(data) {
                        location.reload();
                    },
                    function() {
                        location.reload();
                    },
                    { dataType: 'json', timeout: 300000 }
                ).always(function() {
                    $link.removeClass('disabled').text(originalText);
                });
            });

            $('.provision-staging').on('click', function(e) {
                e.preventDefault();
                var id = $(this).data('id');
                var $link = $(this);
                var originalText = $link.text();
                $link.addClass('disabled').text('<?php echo $this->_('AdminMain.index.provision_running', true); ?>');

                $(this).blestaRequest(
                    'POST',
                    '<?php echo $this->Html->safe($this->base_uri . 'plugin/falcon_theme_snapshots/admin_main/provision_staging/'); ?>',
                    { template_id: id },
                    function(data) {
                        location.reload();
                    },
                    function() {
                        location.reload();
                    },
                    { dataType: 'json', timeout: 300000 }
                ).always(function() {
                    $link.removeClass('disabled').text(originalText);
                });
            });

            $('.delete-template').on('click', function(e) {
                var name = $(this).data('name') || 'this template';
                if (!confirm('<?php echo $this->_('AdminMain.index.confirm_delete', true); ?>'.replace('%1$s', name))) {
                    e.preventDefault();
                }
            });
        });
        </script>
