                    <span class="badge" style="position: absolute; left: 0; top: 2px; font-size: 14px; padding: 6px 10px; background: #337ab7;"><?php echo (int) $step; ?></span>
                    <strong><?php $this->_('AdminMain.guide.step' . $step . '_title'); ?></strong>
