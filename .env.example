# ============================================================
# Falcon of Codes — placeholder env. Copy to a real secret file
# on the SERVER ONLY (never commit the filled-in version).
#
# Real secrets live on the VPS at:
#   /root/.blesta_api_key                     (Blesta API user/key)
#   /root/.blesta_db_credentials              (Blesta DB)
#   /root/.blesta_admin_credentials           (Blesta admin login)
#   /var/lib/falcon-provisioner/secrets/*.env (per-site WP + FTP creds)
# ============================================================

# --- Blesta API (used by tooling, if any) ---
API_USER=falconapi
API_KEY=CHANGved_ME_GENERATE_ON_SERVER   # openssl rand -hex 32

# --- Blesta database ---
BLESTA_DB_HOST=localhost
BLESTA_DB_NAME=falc_blesta
BLESTA_DB_USER=falc_blesta
BLESTA_DB_PASS=CHANGE_ME

# --- Provisioner defaults ---
MASTER_DOMAIN=falcon.codes
SITE_OWNER=admin
DEFAULT_PHP=8.3
DEFAULT_WP_THEME=twentytwentyfour
RESERVATION_MINUTES=45
